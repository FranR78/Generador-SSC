{
  "manifest_version": 3,
  "name": "NotebookLM → GitHub",
  "version": "0.8",
  "description": "Procesa cada fuente de NotebookLM y sube el resultado como .md a GitHub",
  "permissions": ["storage"],
  "host_permissions": ["https://notebook.google.com/*", "https://notebooklm.google.com/*", "https://api.github.com/*"],
  "background": { "service_worker": "bg.js" },
  "content_scripts": [
    { "matches": ["https://notebook.google.com/*", "https://notebooklm.google.com/*"], "js": ["hook.js"], "world": "MAIN", "run_at": "document_start" },
    { "matches": ["https://notebook.google.com/*", "https://notebooklm.google.com/*"], "js": ["defaults.js", "content.js"] }
  ],
  "action": { "default_popup": "popup.html", "default_title": "NotebookLM → GitHub" },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
